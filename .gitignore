# ==========================================
# Android Studio & Gradle - Official .gitignore
# ==========================================

# Built application files / Binaries
*.apk
*.aar
*.ap_
*.aab
*.dex
*.class

# Build and Cache Directories (Niemals einchecken!)
build/
app/build/
.gradle/
bin/
gen/
out/

# Local configuration (Enthält deinen privaten SDK-Pfad)
local.properties

# Android Studio / IntelliJ IDE-spezifische Dateien
.idea/workspace.xml
.idea/tasks.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/deploymentTargetSelector.xml
*.iml
*.iws

# Log-Dateien
*.log

# Betriebssystem-Dateien
.DS_Store
Thumbs.db
desktop.ini

# IMPORTANT EXCEPTION:
# Stelle sicher, dass die Wrapper-JAR trotz eventueller globaler Rules NICHT ignoriert wird!
!gradle/wrapper/gradle-wrapper.jar